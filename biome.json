{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noUnknownAtRules": {
					"level": "error",
					"options": {
						"ignore": [
							"tailwind"
						]
					}
				}
			}
		}
	}
}
